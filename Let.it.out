<!DOCTYPE html>
<html>
<head>
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Ongea Ikutoke - Full App</title>
<style>
body{margin:0;font-family:Arial;background:#0f172a;color:white}
header{background:#16a34a;padding:15px;text-align:center;font-size:22px;font-weight:bold}
.tabs{display:flex;justify-content:space-around;background:#1e293b;padding:10px;position:sticky;top:0}
.tabs button{flex:1;margin:3px;padding:12px;border:none;border-radius:8px;background:#334155;color:white;font-weight:bold}
.tabs button.active{background:#22c55e}
section{display:none;padding:15px}
section.active{display:block}
.card{background:white;color:black;border-radius:12px;padding:12px;margin:12px 0;box-shadow:0 2px 5px rgba(0,0,0,0.3)}
img,video,audio{width:100%;border-radius:10px;margin-top:8px}
input,textarea{width:100%;padding:10px;margin:6px 0;border-radius:8px;border:1px solid #ccc;box-sizing:border-box}
.postBtn{background:#22c55e;color:white;padding:14px;border:none;border-radius:8px;width:100%;font-size:16px;font-weight:bold;margin-top:5px}
small{color:#64748b}
</style>
</head>
<body>
<header>Ongea Ikutoke 🔥📸🎬🔊</header>
<div class="tabs">
<button class="active" onclick="show(event,'text')">Text</button>
<button onclick="show(event,'photo')">Photo</button>
<button onclick="show(event,'video')">Video</button>
<button onclick="show(event,'audio')">Audio</button>
</div>

<section id="text" class="active">
<h3>✍️ Text Post</h3>
<textarea id="tText" rows="4" placeholder="Andika ujumbe wako hapa..."></textarea>
<button class="postBtn" onclick="postText()">Post Text</button>
<div id="textFeed"></div>
</section>

<section id="photo">
<h3>📸 Photo Post</h3>
<input type="file" id="pFile" accept="image/*">
<input type="text" id="pCaption" placeholder="Caption ya picha...">
<button class="postBtn" onclick="postPhoto()">Post Photo</button>
<div id="photoFeed"></div>
</section>

<section id="video">
<h3>🎬 Video Post</h3>
<input type="file" id="vFile" accept="video/*">
<input type="text" id="vCaption" placeholder="Caption ya video...">
<button class="postBtn" onclick="postVideo()">Post Video</button>
<div id="videoFeed"></div>
<h4>YouTube</h4>
<input type="text" id="ytLink" placeholder="Paste YouTube EMBED link e.g https://www.youtube.com/embed/xxx">
<button class="postBtn" onclick="postYT()">Post YouTube</button>
<div id="ytFeed"></div>
</section>

<section id="audio">
<h3>🔊 Audio Post</h3>
<input type="file" id="aFile" accept="audio/*">
<input type="text" id="aCaption" placeholder="Jina la audio...">
<button class="postBtn" onclick="postAudio()">Post Audio</button>
<div id="audioFeed"></div>
<hr>
<h3>🎙️ Record Live Audio</h3>
<button class="postBtn" id="recBtn" onclick="toggleRec()">Start Recording</button>
<div id="recFeed"></div>
</section>

<script>
function show(e,id){
 document.querySelectorAll('section').forEach(s=>s.classList.remove('active'));
 document.getElementById(id).classList.add('active');
 document.querySelectorAll('.tabs button').forEach(b=>b.classList.remove('active'));
 e.target.classList.add('active');
}
function postText(){
 let t=document.getElementById('tText').value;
 if(!t)return alert('Andika kitu!');
 let d=document.createElement('div');d.className='card';d.innerHTML='<b>📝 Text:</b><br>'+t.replace(/\n/g,'<br>')+'<br><small>'+new Date().toLocaleString()+'</small>';
 document.getElementById('textFeed').prepend(d);
 document.getElementById('tText').value='';
}
function postPhoto(){
 let f=document.getElementById('pFile').files[0];let c=document.getElementById('pCaption').value;
 if(!f)return alert('Chagua picha kwanza!');
 let url=URL.createObjectURL(f);
 let d=document.createElement('div');d.className='card';d.innerHTML='<b>📸 '+c+'</b><br><img src="'+url+'"><br><small>'+new Date().toLocaleString()+'</small>';
 document.getElementById('photoFeed').prepend(d);
}
function postVideo(){
 let f=document.getElementById('vFile').files[0];let c=document.getElementById('vCaption').value;
 if(!f)return alert('Chagua video!');
 let url=URL.createObjectURL(f);
 let d=document.createElement('div');d.className='card';d.innerHTML='<b>🎬 '+c+'</b><br><video controls src="'+url+'"></video><br><small>'+new Date().toLocaleString()+'</small>';
 document.getElementById('videoFeed').prepend(d);
}
function postYT(){
 let l=document.getElementById('ytLink').value;if(!l)return alert('Weka link');
 let d=document.createElement('div');d.className='card';d.innerHTML='<iframe width="100%" height="200" src="'+l+'" frameborder="0" allowfullscreen></iframe><br><small>'+new Date().toLocaleString()+'</small>';
 document.getElementById('ytFeed').prepend(d);
 document.getElementById('ytLink').value='';
}
function postAudio(){
 let f=document.getElementById('aFile').files[0];let c=document.getElementById('aCaption').
